{
    "name": "@scheduler/source",
    "packageManager": "yarn@4.18.1",
    "private": true,
    "scripts": {
        "docker:up": "chmod +x ./scripts/docker/up.sh && ./scripts/docker/up.sh",
        "docker:down": "chmod +x ./scripts/docker/down.sh && ./scripts/docker/down.sh",
        "build": "yarn workspaces foreach -Apt run build",
        "test": "FORCE_COLOR=1 yarn workspaces foreach -At run test",
        "clean": "yarn workspaces foreach -Apt run clean"
    },
    "workspaces": [
        "apps/*",
        "packages/*",
        "tests/*"
    ]
}