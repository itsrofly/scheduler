{
    "name": "@scheduler/persistent-database",
    "private": true,
    "scripts": {
        "build": "yarn generate && tsc -p tsconfig.json",
        "clean": "rm -rf dist",
        "generate": "yarn prisma generate",
        "reset": "yarn prisma migrate reset",
        "deploy": "yarn prisma migrate deploy",
        "migrate": "yarn prisma migrate dev",
        "seed": "yarn prisma db seed",
        "postinstall": "yarn generate"
    },
    "exports": {
        ".": {
            "types": "./dist/*.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "prisma": "6.19.3",
        "prisma-field-encryption": "^1.6.0"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "dotenv": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
}
